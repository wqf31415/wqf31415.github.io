<style>
/* Global responsive styles for SVG images on mobile */
.post-body svg,
.post-body img[src$=".svg"] {
  max-width: 100% !important;
  width: 100% !important;
  height: auto !important;
  display: block;
  box-sizing: border-box;
}
</style>
<script>
// Global fix for inline SVG with fixed width on mobile
document.addEventListener('DOMContentLoaded', function() {
  (function() {
    function fixSvgSize() {
      var svgs = document.querySelectorAll('.post-body svg');
      for (var i = 0; i < svgs.length; i++) {
        var svg = svgs[i];
        var width = svg.getAttribute('width');
        var height = svg.getAttribute('height');

        // If SVG has width/height attributes but no viewBox, add viewBox
        if (width && height && !svg.getAttribute('viewBox')) {
          // Remove any units, just get the number
          var wNum = parseFloat(width);
          var hNum = parseFloat(height);
          if (wNum && hNum) {
            svg.setAttribute('viewBox', '0 0 ' + wNum + ' ' + hNum);
          }
        }

        // Force preserveAspectRatio to maintain original ratio
        if (!svg.getAttribute('preserveAspectRatio')) {
          svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
        }
      }
    }
    // Run on page load
    fixSvgSize();
    // Run again after any dynamic content loads
    if (document.addEventListener) {
      document.addEventListener('pjax:complete', fixSvgSize);
    }
  })();
});
</script>
